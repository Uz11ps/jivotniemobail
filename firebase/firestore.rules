rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Публичное чтение контента
    match /appConfig/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && 
        request.auth.token.role in ['admin', 'editor'];
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null && 
        request.auth.token.role in ['admin', 'editor'];
      
      match /animals/{animalId} {
        allow read: if true;
        allow write: if request.auth != null && 
          request.auth.token.role in ['admin', 'editor'];
      }
    }
    
    match /offers/{offerId} {
      allow read: if true;
      allow write: if request.auth != null && 
        request.auth.token.role in ['admin', 'editor'];
    }
    
    // Аналитика - только чтение для админов, запись через Functions
    match /analytics/{document=**} {
      allow read: if request.auth != null && 
        request.auth.token.role in ['admin'];
      allow write: if false; // Только через Functions
    }
  }
}
